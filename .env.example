# ============================================
# DESARROLLO LOCAL (docker compose up -d)
# ============================================
# Django
SECRET_KEY=cambiar-por-una-clave-segura
# Para subdominios wildcard usar formato: .tudominio.com (el punto acepta todos los subdominios)
ALLOWED_HOSTS=localhost,127.0.0.1,.localhost

# MySQL local (Docker compose, puerto 3308)
DB_NAME=catering_saas
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3308


# ============================================
# PRODUCCIÓN (VPS, docker-compose.prod.yml)
# ============================================
# Django
# SECRET_KEY=generar-con-python -c "import secrets; print(secrets.token_urlsafe(50))"
# ALLOWED_HOSTS=tudominio.com,www.tudominio.com,.tudominio.com

# MySQL (dentro de la red Docker)
# DB_ROOT_PASSWORD=clave-segura-de-root
# DB_NAME=catering_saas
# DB_USER=catering_user
# DB_PASSWORD=clave-segura-del-usuario
# DB_HOST=db
# DB_PORT=3306

# MercadoPago (se configura por tenant en el admin; no hace falta como env var)

# Render Free: Postgres (descomentar en prod, Render inyecta DATABASE_URL automaticamente)
# DATABASE_URL=postgres://catering:pass@host:5432/catering_saas

